NODE_ENV=development
PORT=3200
LOG_LEVEL=info

# 本地 Docker MySQL —— 独立库，不碰 demo 的 yishan 库
DATABASE_URL="mysql://root:CHANGE_ME@127.0.0.1:3306/yishan_iximei_crm"
DATABASE_NAME="yishan_iximei_crm"

JWT_SECRET="CHANGE_ME"
JWT_ACCESS_TOKEN_EXPIRES_IN=86400
JWT_REFRESH_TOKEN_EXPIRES_IN=604800

REDIS_URL=redis://127.0.0.1:6379/2
CACHE_TTL_DEFAULT=300
UPLOAD_DIR=./public/uploads

# 老 iximei（ThinkCMF 5.x）密码 authcode —— 迁移老账号时用，新库不涉及
LEGACY_AUTHCODE=CHANGE_ME
