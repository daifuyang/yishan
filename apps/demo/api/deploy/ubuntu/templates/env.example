# 演示环境运行时环境变量模板。
#
# 目标机上这份文件是 /opt/yishan/shared/.env（root:ubuntu 0640，**不进仓库**）。
# 改法：在本机改好 → scp 上去 → sudo chown root:ubuntu && sudo chmod 0640 → 重启服务。
#
# 变量名与目标机上的实际文件一一对应（值全部是占位符）。
# 注意 ADMIN_BASE_PATH / ADMIN_REDIRECT_ROOT 是 **root 模式**：Admin 挂在站点根，
# 和构建时的 PUBLIC_PATH=/ 必须一致，写成 /admin 会让 admin 作用域和 /api 打架。

NODE_ENV=production
PORT=3000
HOST=127.0.0.1
DATABASE_URL=mysql://<user>:<password>@139.196.89.64:3306/yishan_demo
REDIS_URL=redis://:<password>@139.196.89.64:6379/0
JWT_SECRET=<generate-with-openssl-rand-hex-32>
CACHE_NAMESPACE=yishan:demo
TRUST_PROXY_IPS=127.0.0.1
# root 模式：Admin 挂站点根。改成 /admin 时 PUBLIC_PATH 也必须是 /admin/。
ADMIN_BASE_PATH=/
ADMIN_REDIRECT_ROOT=false
LOG_LEVEL=info
