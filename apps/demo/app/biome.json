{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*",
      "!**/dist",
      "!**/node_modules",
      "!**/.taro",
      "!**/.build",
      "!**/fonts-subset",
      "!biome.json",
      "!src/index.html",
      "!**/WeuiPicker.h5.css"
    ]
  },
  "overrides": [
    {
      "includes": ["**/tests/browser/**"],
      "formatter": {
        "enabled": false
      }
    }
  ],
  "linter": {
    "rules": {
      "complexity": {
        "noImportantStyles": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "off"
      }
    }
  },
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "javascript": {
    "jsxRuntime": "reactClassic",
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "css": {
    "formatter": {
      "enabled": true
    }
  }
}
