{
  "name": "@yishan/tiptap",
  "version": "0.0.1-dev.0",
  "publishConfig": {
    "access": "public",
    "tag": "dev"
  },
  "description": "A React component library with TipTap editor",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs"
    },
    "./index.css": "./dist/index.css"
  },
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node ./scripts/clean-dist.mjs && rollup -c",
    "dev": "rollup -c -w",
    "clean": "node ./scripts/clean-dist.mjs",
    "verify:package": "node ./scripts/verify-package.mjs",
    "prepack": "pnpm run build && pnpm run verify:package"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@floating-ui/react": "^0.27.16",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@rollup/plugin-alias": "^5.1.0",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.5",
    "@tiptap/core": "3.11.0",
    "@tiptap/extension-bubble-menu": "3.11.0",
    "@tiptap/extension-color": "3.11.0",
    "@tiptap/extension-floating-menu": "3.11.0",
    "@tiptap/extension-highlight": "3.11.0",
    "@tiptap/extension-horizontal-rule": "3.11.0",
    "@tiptap/extension-image": "3.11.0",
    "@tiptap/extension-list": "3.11.0",
    "@tiptap/extension-subscript": "3.11.0",
    "@tiptap/extension-superscript": "3.11.0",
    "@tiptap/extension-text-align": "3.11.0",
    "@tiptap/extension-text-style": "3.11.0",
    "@tiptap/extension-typography": "3.11.0",
    "@tiptap/extensions": "3.11.0",
    "@tiptap/pm": "3.11.0",
    "@tiptap/react": "3.11.0",
    "@tiptap/starter-kit": "3.11.0",
    "@types/lodash.throttle": "^4.1.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "lodash.throttle": "^4.1.1",
    "lucide-react": "^0.548.0",
    "react-hotkeys-hook": "^5.2.1",
    "react-tooltip": "^5.30.0",
    "rollup": "^4.6.1",
    "rollup-plugin-dts": "^6.1.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "sass": "^1.93.2",
    "sass-embedded": "^1.93.2",
    "tslib": "^2.6.2",
    "typescript": "^5.3.2"
  }
}
