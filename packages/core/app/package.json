{
  "name": "@yishan/core-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reusable Taro request, session, storage and hook capabilities with product-owned configuration.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./request": "./src/request/index.ts",
    "./request/types": "./src/request/types.ts",
    "./auth": "./src/auth/index.ts",
    "./storage": "./src/storage/index.ts",
    "./env": "./src/env/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./permissions": "./src/permissions/index.ts",
    "./router": "./src/router/index.ts"
  },
  "files": ["src", "dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs"
  },
  "peerDependencies": {
    "@tarojs/taro": "^4.0.0",
    "react": ">=18 <20"
  },
  "dependencies": { "zustand": "^5.0.14" },
  "devDependencies": {
    "@tarojs/taro": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "react": "^18.3.1",
    "typescript": "~5.4.5"
  }
}
